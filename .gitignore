config.json.backup-*
models.ini.backup-*
stats.json
wiki/
logs/
__pycache__/
*.pyc

# a user's cloned engine + build artifacts
llama.cpp/

# Docker runtime volumes (config + models live on the host, not in git)
config/
models/

# local editor / agent tooling config
.claude/
CLAUDE.md

# agent design/plan artifacts (superpowers) - keep internal, don't publish
docs/superpowers/

# docs site build output + local-only working docs
site/
docs/content/_*.md
